<?xml version="1.0" encoding="UTF-8"?>
<!-- Prototype panel: drawn by VSTGUI, no rendered art yet. -->
<vstgui-ui-description version="1">
	<colors>
		<color name="plate" rgba="#1d1e21ff"/>
		<color name="ink" rgba="#d9d6cfff"/>
		<color name="dim" rgba="#8a8780ff"/>
		<color name="accent" rgba="#e8a33dff"/>
		<color name="accent2" rgba="#5fb3c9ff"/>
		<color name="band1" rgba="#d95926ff"/>
		<color name="band2" rgba="#e8a33dff"/>
		<color name="band3" rgba="#19a36fff"/>
		<color name="band4" rgba="#3987e5ff"/>
		<color name="track" rgba="#2c2e33ff"/>
		<color name="rule" rgba="#3a3c42ff"/>
	</colors>
	<fonts>
		<font name="title" font-name="Arial" size="22" bold="true"/>
		<font name="label" font-name="Arial" size="13" bold="true"/>
		<font name="value" font-name="Arial" size="12"/>
		<font name="small" font-name="Arial" size="11"/>
	</fonts>
	<control-tags>
		<control-tag name="kLow" tag="0"/>
		<control-tag name="kLowMid" tag="1"/>
		<control-tag name="kHighMid" tag="2"/>
		<control-tag name="kHigh" tag="3"/>
		<control-tag name="kX1" tag="4"/>
		<control-tag name="kX2" tag="5"/>
		<control-tag name="kX3" tag="6"/>
	</control-tags>
	<template name="view" class="CViewContainer" origin="0, 0" size="1100, 300" minSize="1100, 300" maxSize="1100, 300" background-color="plate" transparent="false">

		<view class="CTextLabel" origin="24, 14" size="200, 28" title="WET REDUCER" font="title" font-color="ink" text-alignment="left" transparent="true" style-no-frame="true"/>
		<view class="CTextLabel" origin="24, 40" size="240, 18" title="multiband tone reducer - prototype" font="small" font-color="dim" text-alignment="left" transparent="true" style-no-frame="true"/>
		<view class="CTextLabel" origin="24, 110" size="170, 16" title="0  =  original" font="small" font-color="dim" text-alignment="left" transparent="true" style-no-frame="true"/>
		<view class="CTextLabel" origin="24, 128" size="170, 16" title="50  =  sine blend" font="small" font-color="dim" text-alignment="left" transparent="true" style-no-frame="true"/>
		<view class="CTextLabel" origin="24, 146" size="170, 16" title="100  =  square" font="small" font-color="dim" text-alignment="left" transparent="true" style-no-frame="true"/>

		<!-- four band knobs, each with its start (0) and end (100) marked at the arc's ends -->
		<view class="CKnob" origin="200, 44" size="120, 120" control-tag="kLow" circle-drawing="false" corona-drawing="true" corona-outline="true" corona-color="band1" handle-color="ink" handle-shadow-color="rule" corona-inset="4" handle-line-width="3" corona-line-width="5" angle-start="135" angle-range="270" transparent="true"/>
		<view class="CTextLabel" origin="196, 158" size="30, 14" title="0" font="small" font-color="dim" transparent="true" style-no-frame="true"/>
		<view class="CTextLabel" origin="294, 158" size="30, 14" title="100" font="small" font-color="dim" transparent="true" style-no-frame="true"/>
		<view class="CTextLabel" origin="200, 172" size="120, 18" title="LOW" font="label" font-color="band1" transparent="true" style-no-frame="true"/>
		<view class="CParamDisplay" origin="200, 190" size="120, 18" control-tag="kLow" font="value" font-color="dim" transparent="true" style-no-frame="true"/>

		<view class="CKnob" origin="420, 44" size="120, 120" control-tag="kLowMid" circle-drawing="false" corona-drawing="true" corona-outline="true" corona-color="band2" handle-color="ink" handle-shadow-color="rule" corona-inset="4" handle-line-width="3" corona-line-width="5" angle-start="135" angle-range="270" transparent="true"/>
		<view class="CTextLabel" origin="416, 158" size="30, 14" title="0" font="small" font-color="dim" transparent="true" style-no-frame="true"/>
		<view class="CTextLabel" origin="514, 158" size="30, 14" title="100" font="small" font-color="dim" transparent="true" style-no-frame="true"/>
		<view class="CTextLabel" origin="420, 172" size="120, 18" title="LOW MID" font="label" font-color="band2" transparent="true" style-no-frame="true"/>
		<view class="CParamDisplay" origin="420, 190" size="120, 18" control-tag="kLowMid" font="value" font-color="dim" transparent="true" style-no-frame="true"/>

		<view class="CKnob" origin="640, 44" size="120, 120" control-tag="kHighMid" circle-drawing="false" corona-drawing="true" corona-outline="true" corona-color="band3" handle-color="ink" handle-shadow-color="rule" corona-inset="4" handle-line-width="3" corona-line-width="5" angle-start="135" angle-range="270" transparent="true"/>
		<view class="CTextLabel" origin="636, 158" size="30, 14" title="0" font="small" font-color="dim" transparent="true" style-no-frame="true"/>
		<view class="CTextLabel" origin="734, 158" size="30, 14" title="100" font="small" font-color="dim" transparent="true" style-no-frame="true"/>
		<view class="CTextLabel" origin="640, 172" size="120, 18" title="HIGH MID" font="label" font-color="band3" transparent="true" style-no-frame="true"/>
		<view class="CParamDisplay" origin="640, 190" size="120, 18" control-tag="kHighMid" font="value" font-color="dim" transparent="true" style-no-frame="true"/>

		<view class="CKnob" origin="860, 44" size="120, 120" control-tag="kHigh" circle-drawing="false" corona-drawing="true" corona-outline="true" corona-color="band4" handle-color="ink" handle-shadow-color="rule" corona-inset="4" handle-line-width="3" corona-line-width="5" angle-start="135" angle-range="270" transparent="true"/>
		<view class="CTextLabel" origin="856, 158" size="30, 14" title="0" font="small" font-color="dim" transparent="true" style-no-frame="true"/>
		<view class="CTextLabel" origin="954, 158" size="30, 14" title="100" font="small" font-color="dim" transparent="true" style-no-frame="true"/>
		<view class="CTextLabel" origin="860, 172" size="120, 18" title="HIGH" font="label" font-color="band4" transparent="true" style-no-frame="true"/>
		<view class="CParamDisplay" origin="860, 190" size="120, 18" control-tag="kHigh" font="value" font-color="dim" transparent="true" style-no-frame="true"/>

		<!-- the three crossovers on one frequency strip: drag a handle; the bands are shaded in their
		     knob's colour, stronger the further that knob is turned -->
		<view class="CView" custom-view-name="XoverStrip" origin="200, 220" size="780, 72" transparent="true"/>
	</template>
</vstgui-ui-description>
