<?xml version="1.0" encoding="UTF-8"?>
<!-- Prototype panel: drawn by VSTGUI, no rendered art yet. Roughly 2U proportions. -->
<vstgui-ui-description version="1">
	<colors>
		<color name="plate" rgba="#1d1e21ff"/>
		<color name="ink" rgba="#d9d6cfff"/>
		<color name="dim" rgba="#8a8780ff"/>
		<color name="accent" rgba="#e8a33dff"/>
		<color name="accent2" rgba="#5fb3c9ff"/>
		<color name="knob" rgba="#2c2e33ff"/>
		<color name="shadow" rgba="#00000080"/>
		<color name="rule" rgba="#3a3c42ff"/>
	</colors>
	<fonts>
		<font name="title" font-name="Arial" size="22" bold="true"/>
		<font name="label" font-name="Arial" size="13" bold="true"/>
		<font name="value" font-name="Arial" size="12"/>
		<font name="small" font-name="Arial" size="11"/>
	</fonts>
	<control-tags>
		<control-tag name="kLow" tag="0"/>
		<control-tag name="kLowMid" tag="1"/>
		<control-tag name="kHighMid" tag="2"/>
		<control-tag name="kHigh" tag="3"/>
		<control-tag name="kX1" tag="4"/>
		<control-tag name="kX2" tag="5"/>
		<control-tag name="kX3" tag="6"/>
	</control-tags>
	<template name="view" class="CViewContainer" origin="0, 0" size="1100, 240" minSize="1100, 240" maxSize="1100, 240" background-color="plate" transparent="false">

		<view class="CTextLabel" origin="24, 14" size="200, 28" title="WET REDUCER" font="title" font-color="ink" text-alignment="left" transparent="true" style-no-frame="true"/>
		<view class="CTextLabel" origin="24, 40" size="240, 18" title="multiband tone reducer - prototype" font="small" font-color="dim" text-alignment="left" transparent="true" style-no-frame="true"/>

		<!-- band 1 -->
		<view class="CKnob" origin="200, 52" size="120, 120" control-tag="kLow" circle-drawing="false" corona-outline="true" corona-drawing="true" corona-color="accent" handle-color="ink" handle-shadow-color="rule" corona-inset="4" handle-line-width="3" corona-line-width="5" angle-start="135" angle-range="270" transparent="true"/>
		<view class="CTextLabel" origin="200, 176" size="120, 18" title="LOW" font="label" font-color="ink" transparent="true" style-no-frame="true"/>
		<view class="CParamDisplay" origin="200, 196" size="120, 18" control-tag="kLow" font="value" font-color="dim" transparent="true" style-no-frame="true"/>

		<!-- crossover 1 -->
		<view class="CKnob" origin="342, 110" size="56, 56" control-tag="kX1" circle-drawing="false" corona-outline="true" corona-drawing="true" corona-color="accent2" handle-color="ink" handle-shadow-color="rule" corona-inset="3" handle-line-width="2" corona-line-width="3" angle-start="135" angle-range="270" transparent="true"/>
		<view class="CTextLabel" origin="320, 176" size="100, 18" title="LF / LMF" font="small" font-color="ink" transparent="true" style-no-frame="true"/>
		<view class="CParamDisplay" origin="320, 196" size="100, 18" control-tag="kX1" font="value" font-color="dim" transparent="true" style-no-frame="true"/>

		<!-- band 2 -->
		<view class="CKnob" origin="420, 52" size="120, 120" control-tag="kLowMid" circle-drawing="false" corona-outline="true" corona-drawing="true" corona-color="accent" handle-color="ink" handle-shadow-color="rule" corona-inset="4" handle-line-width="3" corona-line-width="5" angle-start="135" angle-range="270" transparent="true"/>
		<view class="CTextLabel" origin="420, 176" size="120, 18" title="LOW MID" font="label" font-color="ink" transparent="true" style-no-frame="true"/>
		<view class="CParamDisplay" origin="420, 196" size="120, 18" control-tag="kLowMid" font="value" font-color="dim" transparent="true" style-no-frame="true"/>

		<!-- crossover 2 -->
		<view class="CKnob" origin="562, 110" size="56, 56" control-tag="kX2" circle-drawing="false" corona-outline="true" corona-drawing="true" corona-color="accent2" handle-color="ink" handle-shadow-color="rule" corona-inset="3" handle-line-width="2" corona-line-width="3" angle-start="135" angle-range="270" transparent="true"/>
		<view class="CTextLabel" origin="540, 176" size="100, 18" title="LMF / HMF" font="small" font-color="ink" transparent="true" style-no-frame="true"/>
		<view class="CParamDisplay" origin="540, 196" size="100, 18" control-tag="kX2" font="value" font-color="dim" transparent="true" style-no-frame="true"/>

		<!-- band 3 -->
		<view class="CKnob" origin="640, 52" size="120, 120" control-tag="kHighMid" circle-drawing="false" corona-outline="true" corona-drawing="true" corona-color="accent" handle-color="ink" handle-shadow-color="rule" corona-inset="4" handle-line-width="3" corona-line-width="5" angle-start="135" angle-range="270" transparent="true"/>
		<view class="CTextLabel" origin="640, 176" size="120, 18" title="HIGH MID" font="label" font-color="ink" transparent="true" style-no-frame="true"/>
		<view class="CParamDisplay" origin="640, 196" size="120, 18" control-tag="kHighMid" font="value" font-color="dim" transparent="true" style-no-frame="true"/>

		<!-- crossover 3 -->
		<view class="CKnob" origin="782, 110" size="56, 56" control-tag="kX3" circle-drawing="false" corona-outline="true" corona-drawing="true" corona-color="accent2" handle-color="ink" handle-shadow-color="rule" corona-inset="3" handle-line-width="2" corona-line-width="3" angle-start="135" angle-range="270" transparent="true"/>
		<view class="CTextLabel" origin="760, 176" size="100, 18" title="HMF / HF" font="small" font-color="ink" transparent="true" style-no-frame="true"/>
		<view class="CParamDisplay" origin="760, 196" size="100, 18" control-tag="kX3" font="value" font-color="dim" transparent="true" style-no-frame="true"/>

		<!-- band 4 -->
		<view class="CKnob" origin="860, 52" size="120, 120" control-tag="kHigh" circle-drawing="false" corona-outline="true" corona-drawing="true" corona-color="accent" handle-color="ink" handle-shadow-color="rule" corona-inset="4" handle-line-width="3" corona-line-width="5" angle-start="135" angle-range="270" transparent="true"/>
		<view class="CTextLabel" origin="860, 176" size="120, 18" title="HIGH" font="label" font-color="ink" transparent="true" style-no-frame="true"/>
		<view class="CParamDisplay" origin="860, 196" size="120, 18" control-tag="kHigh" font="value" font-color="dim" transparent="true" style-no-frame="true"/>

		<view class="CTextLabel" origin="24, 120" size="170, 16" title="0  =  original" font="small" font-color="dim" text-alignment="left" transparent="true" style-no-frame="true"/>
		<view class="CTextLabel" origin="24, 138" size="170, 16" title="noon  =  sine blend" font="small" font-color="dim" text-alignment="left" transparent="true" style-no-frame="true"/>
		<view class="CTextLabel" origin="24, 156" size="170, 16" title="full  =  square" font="small" font-color="dim" text-alignment="left" transparent="true" style-no-frame="true"/>
	</template>
</vstgui-ui-description>
